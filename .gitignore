# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Standalone regression fixtures under tests/fixtures/ are intentionally kept out
# of the workspace (feature-unification isolation; see the root Cargo.toml and
# RFC-031). Their Cargo.lock is regenerated on demand and must not be tracked as a
# second workspace lock.
/tests/fixtures/*/Cargo.lock

# The RFC-049 benchmark harness is a workspace-excluded crate (publish = false);
# its Cargo.lock is regenerated on demand and must not be tracked (see RFC-049 Q2).
/benchmarks/Cargo.lock

# The RFC-063 local report tool is workspace-excluded (publish = false);
# its Cargo.lock is regenerated on demand and must not be tracked.
/tools/matten-report/Cargo.lock

# The RFC-054 local migration-readiness tool is workspace-excluded (publish = false);
# its Cargo.lock is regenerated on demand and must not be tracked.
/tools/matten-migrate/Cargo.lock

# The RFC-093 browser shape playground's WebAssembly binding is workspace-excluded
# (publish = false); its Cargo.lock is regenerated on demand and must not be tracked.
/tools/matten-playground/Cargo.lock

# RFC-093: the shape playground's compiled wasm module and its wasm-bindgen JS
# glue. Generated by CI (.github/workflows/docs.yaml) before every `mdbook build`,
# same policy as the other workspace-excluded tools' locks above: build artifacts
# are regenerated on demand, not tracked. See docs/src/playground.md for the
# local-build command.
/docs/src/playground/*.js
/docs/src/playground/*.wasm
/docs/src/playground/*.d.ts

# mdbook's build output. `mdbook build docs` writes here (no build-dir override in
# docs/book.toml, so this is mdbook's default). Never tracked; every verification
# block in the RFC handoffs runs `mdbook build docs && rm -rf docs/book` precisely
# because it was not ignored, which left it showing as `??` in every git status and
# one `git add -A` away from being committed.
/docs/book/

# custom
/.git-exclude/

# Claude Code project-local config (settings.local.json etc.) — machine/session-specific,
# must never be tracked or pushed. Previously relied only on a personal global gitignore;
# that is not portable to another clone or contributor.
*.local.json
